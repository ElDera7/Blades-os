# BladeOS settings. Locally: copy to .env (never commit .env).
# On a host, add these in its settings / secrets instead:
#   Fly.io:  fly secrets set JWT_SECRET=... ADMIN_EMAIL=...      Render / Koyeb / DigitalOcean: Environment tab
# See DEPLOY.md for each host.

# PostgreSQL 14+ connection string. SSL is used automatically except on the host's private network.
# PGSSL=true / false forces it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bladeos

# Random 32+ character string: openssl rand -hex 32
# MOVING HOST: use the SAME value as before, or everyone's two-step sign-in stops working (see DEPLOY.md).
JWT_SECRET=

# The first account (the Super Admin) — created on first boot if there are no users.
# On an existing database, this account is made Super Admin if there is none.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Jeffrey

# The address people open, e.g. https://bladeos.onrender.com (needed for a custom domain: emails,
# unsubscribe links and the till setup file use it). Without it: the host's own address.
# PUBLIC_URL=https://bladeos.onrender.com

# Only for docker-compose.yml (its own PostgreSQL):
# POSTGRES_PASSWORD=

# Two-step sign-in is optional (account menu). true = mandatory for Super Admin, Owner, MD and Administrator.
# REQUIRE_TWO_STEP=true

# Break-glass only: clears two-step sign-in for this email on the next boot (lost phone AND recovery codes,
# or a new JWT_SECRET after moving host). Remove it again straight after signing in.
# RESET_MFA_FOR=

# Customer emails (birthday greetings, marketing) through Resend.
# RESEND_API_KEY=
# EMAIL_FROM=Blades & Butchers <hello@bladesbutchers.com>

# Backups. Without S3 settings: Render's own daily PostgreSQL backups + the weekly encrypted download
# from Administration → Backups. 12+ characters; KEEP THIS SAFE — without it backups can't be opened.
BACKUP_PASSPHRASE=
# Optional automatic off-site copies to S3-compatible storage (Cloudflare R2, Backblaze B2, AWS S3, Wasabi):
#   R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region auto
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=auto
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_PREFIX=bladeos/
# BACKUP_RETENTION_DAYS=35
